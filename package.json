{
  "name": "agentforge-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @agentforge/web --filter @agentforge/server dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @agentforge/web test:e2e",
    "app:doctor": "pnpm --filter @agentforge/cli exec tsx src/index.ts doctor",
    "infra:up": "docker compose up -d postgres",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f postgres"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
