{
  "additionalProperties": false,
  "description": "Consumes a valid DirectoryGrant — does not mint grants from client paths.",
  "properties": {
    "directoryGrantId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Directorygrantid",
      "type": "string"
    },
    "dirtyPolicy": {
      "default": "committed_only",
      "enum": [
        "committed_only",
        "controlled_dirty_snapshot",
        "user_must_clean"
      ],
      "title": "Dirtypolicy",
      "type": "string"
    },
    "displayName": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Displayname"
    },
    "note": {
      "anyOf": [
        {
          "maxLength": 1024,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    }
  },
  "required": [
    "directoryGrantId"
  ],
  "title": "ProjectCreateRequest",
  "type": "object"
}
