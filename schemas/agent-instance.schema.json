        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sessionref"
    },
    "stageId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
