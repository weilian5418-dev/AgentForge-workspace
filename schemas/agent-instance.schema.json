{
  "additionalProperties": false,
  "description": "Platform-managed role execution instance (not the API process instance).",
  "properties": {
    "agentProfileId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Agentprofileid",
      "type": "string"
    },
    "assignmentId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Assignmentid",
      "type": "string"
    },
    "budgetRef": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budgetref"
    },
    "currentAttemptId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currentattemptid"
    },
    "executionEnvironment": {
      "maxLength": 512,
      "minLength": 1,
