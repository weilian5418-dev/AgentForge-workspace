{
  "$defs": {
    "CurrentExecutionRef": {
      "additionalProperties": false,
      "description": "What the instance is bound to right now — not lifecycle and not idle/busy.",
      "properties": {
        "attemptId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attemptid"
        },
        "generation": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation"
        },
        "stageId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stageid"
        },
        "workPackageId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workpackageid"
        }
      },
      "title": "CurrentExecutionRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Platform-managed role execution instance (not the API process instance).\n\nOne instance may have many historical native sessions; only one active binding\nis valid at a time. Do not overwrite old sessionRef and lose history.",
  "properties": {
    "activity": {
      "anyOf": [
        {
          "enum": [
            "idle",
            "busy",
            "waiting_input",
            "waiting_approval"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Activity"
    },
    "agentProfileId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Agentprofileid",
      "type": "string"
    },
    "assignmentId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Assignmentid",
      "type": "string"
    },
    "assignmentVersion": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assignmentversion"
    },
    "budgetRef": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budgetref"
    },
    "currentAttemptId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currentattemptid"
    },
    "currentExecution": {
      "anyOf": [
        {
          "$ref": "#/$defs/CurrentExecutionRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "executionEnvironment": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Executionenvironment",
      "type": "string"
    },
    "instanceId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Instanceid",
      "type": "string"
    },
    "lifecycle": {
      "anyOf": [
        {
          "enum": [
            "created",
            "starting",
            "active",
            "stop_requested",
            "stopped",
            "unknown",
            "failed",
            "closed",
            "needs_reconciliation"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lifecycle"
    },
    "nativeSessionId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Nativesessionid"
    },
    "permissionScopeRef": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Permissionscoperef"
    },
    "roleId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Roleid",
      "type": "string"
    },
    "runId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Runid",
      "type": "string"
    },
    "sessionRef": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sessionref"
    },
    "stageId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stageid"
    },
    "status": {
      "anyOf": [
        {
          "enum": [
            "created",
            "starting",
            "running",
            "waiting_input",
            "waiting_approval",
            "stop_requested",
            "stopped",
            "unknown",
            "reconciling",
            "blocked",
            "failed",
            "closed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status"
    },
    "workspaceId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workspaceid"
    }
  },
  "required": [
    "instanceId",
    "assignmentId",
    "runId",
    "roleId",
    "agentProfileId",
    "executionEnvironment"
  ],
  "title": "AgentInstance",
  "type": "object"
}
