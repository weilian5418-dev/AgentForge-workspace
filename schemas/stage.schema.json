{
  "$defs": {
    "StageGatePolicy": {
      "additionalProperties": false,
      "properties": {
        "conflictResolution": {
          "default": "escalate_user",
          "enum": [
            "escalate_user",
            "unanimous",
            "majority"
          ],
          "title": "Conflictresolution",
          "type": "string"
        },
        "maxRepairRounds": {
          "default": 3,
          "maximum": 10,
          "minimum": 0,
          "title": "Maxrepairrounds",
          "type": "integer"
        },
        "policy": {
          "default": "stage_atomic",
          "enum": [
            "stage_atomic",
            "dependency_branch"
          ],
          "title": "Policy",
          "type": "string"
        },
        "requireUserDecision": {
          "default": false,
          "title": "Requireuserdecision",
          "type": "boolean"
        },
        "requiredReviewRoles": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Requiredreviewroles",
          "type": "array"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "title": "StageGatePolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Runtime stage instance. Plan-time definitions live in PlanStageDefinition.",
  "properties": {
    "assignmentVersion": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assignmentversion"
    },
    "concurrencyVersion": {
      "default": 1,
      "minimum": 1,
      "title": "Concurrencyversion",
      "type": "integer"
    },
    "currentCandidateId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currentcandidateid"
    },
    "currentCandidateSetId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currentcandidatesetid"
    },
    "currentReviewCycleId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currentreviewcycleid"
    },
    "dependencies": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._:-]+$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Dependencies",
      "type": "array"
    },
    "gatePolicy": {
      "$ref": "#/$defs/StageGatePolicy"
    },
    "gatePolicyVersion": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gatepolicyversion"
    },
    "planVersion": {
      "minimum": 1,
      "title": "Planversion",
      "type": "integer"
    },
    "repairRound": {
      "default": 0,
      "maximum": 10,
      "minimum": 0,
      "title": "Repairround",
      "type": "integer"
    },
    "requiredWorkPackages": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._:-]+$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Requiredworkpackages",
      "type": "array"
    },
    "runId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runid"
    },
    "stageId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Stageid",
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "ready",
        "executing",
        "submission_requested",
        "stopping",
        "frozen",
        "reviewing",
        "released",
        "rework",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "waitingReason": {
      "default": "none",
      "enum": [
        "awaiting_stop_verification",
        "awaiting_validation",
        "awaiting_review",
        "awaiting_user_decision",
        "awaiting_permission",
        "budget_exhausted",
        "none"
      ],
      "title": "Waitingreason",
      "type": "string"
    }
  },
  "required": [
    "stageId",
    "planVersion",
    "gatePolicy",
    "status"
  ],
  "title": "Stage",
  "type": "object"
}
