{
  "$defs": {
    "ProjectBaseline": {
      "additionalProperties": false,
      "properties": {
        "baselineId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Baselineid",
          "type": "string"
        },
        "checkedAt": {
          "format": "date-time",
          "title": "Checkedat",
          "type": "string"
        },
        "dirtyPolicy": {
          "enum": [
            "committed_only",
            "controlled_dirty_snapshot",
            "user_must_clean"
          ],
          "title": "Dirtypolicy",
          "type": "string"
        },
        "environmentId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Environmentid",
          "type": "string"
        },
        "gitCommit": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gitcommit"
        },
        "gitDirtySummary": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Gitdirtysummary",
          "type": "object"
        },
        "isGit": {
          "title": "Isgit",
          "type": "boolean"
        },
        "manifestHash": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manifesthash"
        },
        "notes": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Notes",
          "type": "array"
        },
        "projectId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Projectid",
          "type": "string"
        },
        "scopeStrategy": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Scopestrategy",
          "type": "string"
        },
        "status": {
          "enum": [
            "ready",
            "partial",
            "blocked",
            "unstable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "baselineId",
        "projectId",
        "environmentId",
        "dirtyPolicy",
        "status",
        "isGit",
        "scopeStrategy",
        "checkedAt"
      ],
      "title": "ProjectBaseline",
      "type": "object"
    },
    "ProjectPrecheckSummary": {
      "additionalProperties": false,
      "properties": {
        "accessible": {
          "title": "Accessible",
          "type": "boolean"
        },
        "blockers": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Blockers",
          "type": "array"
        },
        "buildManifests": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Buildmanifests",
          "type": "array"
        },
        "dirty": {
          "title": "Dirty",
          "type": "boolean"
        },
        "dirtyPolicy": {
          "enum": [
            "committed_only",
            "controlled_dirty_snapshot",
            "user_must_clean"
          ],
          "title": "Dirtypolicy",
          "type": "string"
        },
        "gitCommit": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gitcommit"
        },
        "isGit": {
          "title": "Isgit",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "ready",
            "partial",
            "blocked",
            "unstable"
          ],
          "title": "Status",
          "type": "string"
        },
        "workspaceHints": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Workspacehints",
          "type": "array"
        }
      },
      "required": [
        "accessible",
        "isGit",
        "dirty",
        "dirtyPolicy",
        "status"
      ],
      "title": "ProjectPrecheckSummary",
      "type": "object"
    },
    "TrustPolicy": {
      "additionalProperties": false,
      "description": "Server-defined typed trust rules — callers cannot invent privilege escalations.",
      "properties": {
        "allowFollowSymlinks": {
          "default": false,
          "title": "Allowfollowsymlinks",
          "type": "boolean"
        },
        "allowZeroByteInputs": {
          "default": true,
          "title": "Allowzerobyteinputs",
          "type": "boolean"
        },
        "maxDepth": {
          "default": 32,
          "maximum": 64,
          "minimum": 1,
          "title": "Maxdepth",
          "type": "integer"
        },
        "maxFileBytes": {
          "default": 52428800,
          "maximum": 104857600,
          "minimum": 1,
          "title": "Maxfilebytes",
          "type": "integer"
        },
        "maxFiles": {
          "default": 10000,
          "maximum": 100000,
          "minimum": 1,
          "title": "Maxfiles",
          "type": "integer"
        },
        "maxTotalReadBytes": {
          "default": 209715200,
          "maximum": 1073741824,
          "minimum": 1,
          "title": "Maxtotalreadbytes",
          "type": "integer"
        }
      },
      "title": "TrustPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "baseline": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectBaseline"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    },
    "currentBaselineId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currentbaselineid"
    },
    "directoryGrantId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Directorygrantid",
      "type": "string"
    },
    "displayName": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Displayname"
    },
    "environmentId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Environmentid",
      "type": "string"
    },
    "grantStatus": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Grantstatus",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Id",
      "type": "string"
    },
    "precheck": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProjectPrecheckSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "rootPath": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Rootpath",
      "type": "string"
    },
    "trustPolicy": {
      "$ref": "#/$defs/TrustPolicy"
    },
    "updatedAt": {
      "format": "date-time",
      "title": "Updatedat",
      "type": "string"
    },
    "workspaceRoot": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Workspaceroot",
      "type": "string"
    }
  },
  "required": [
    "id",
    "directoryGrantId",
    "rootPath",
    "workspaceRoot",
    "trustPolicy",
    "revision",
    "grantStatus",
    "environmentId",
    "createdAt",
    "updatedAt"
  ],
  "title": "ProjectResponse",
  "type": "object"
}
