{
  "$defs": {
    "RecoveryCase": {
      "additionalProperties": false,
      "properties": {
        "assignmentVersion": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assignmentversion"
        },
        "blockerCodes": {
          "items": {
            "anyOf": [
              {
                "enum": [
                  "native_state_unknown",
                  "workspace_mismatch",
                  "pending_side_effects",
                  "pending_stop_verification",
                  "recovery_evidence_stale",
                  "resume_unsupported",
                  "handoff_confirmation_required",
                  "authorization_invalid",
                  "candidate_hash_mismatch",
                  "budget_unknown",
                  "context_changed",
                  "login_expired"
                ],
                "type": "string"
              },
              {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              }
            ]
          },
          "maxItems": 16,
          "title": "Blockercodes",
          "type": "array"
        },
        "caseId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Caseid",
          "type": "string"
        },
        "caseVersion": {
          "minimum": 1,
          "title": "Caseversion",
          "type": "integer"
        },
        "contextHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contexthash",
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "title": "Createdat",
          "type": "string"
        },
        "planVersion": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planversion"
        },
        "proposedAction": {
          "anyOf": [
            {
              "enum": [
                "observe_existing",
                "continue_stage_processing",
                "resume_existing",
                "handoff_new_session",
                "await_reconciliation",
                "block_or_rework",
                "wait_authorization",
                "await_stop_verification",
                "rebuild_projection"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposedaction"
        },
        "requestOperationId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requestoperationid"
        },
        "runId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Runid",
          "type": "string"
        },
        "status": {
          "enum": [
            "open",
            "observing",
            "awaiting_decision",
            "applying",
            "applied",
            "blocked",
            "superseded",
            "canceled"
          ],
          "title": "Status",
          "type": "string"
        },
        "updatedAt": {
          "format": "date-time",
          "title": "Updatedat",
          "type": "string"
        }
      },
      "required": [
        "caseId",
        "runId",
        "contextHash",
        "caseVersion",
        "status",
        "createdAt",
        "updatedAt"
      ],
      "title": "RecoveryCase",
      "type": "object"
    },
    "RecoveryDecision": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "caseId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Caseid",
          "type": "string"
        },
        "caseVersion": {
          "minimum": 1,
          "title": "Caseversion",
          "type": "integer"
        },
        "contextHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contexthash",
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "title": "Createdat",
          "type": "string"
        },
        "decision": {
          "enum": [
            "observe_existing",
            "continue_stage_processing",
            "resume_existing",
            "handoff_new_session",
            "await_reconciliation",
            "block_or_rework",
            "wait_authorization",
            "await_stop_verification",
            "rebuild_projection"
          ],
          "title": "Decision",
          "type": "string"
        },
        "decisionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Decisionid",
          "type": "string"
        },
        "decisionKey": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Decisionkey",
          "type": "string"
        },
        "evidenceRefs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Evidencerefs",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "decisionId",
        "caseId",
        "caseVersion",
        "decisionKey",
        "contextHash",
        "decision",
        "actor",
        "createdAt"
      ],
      "title": "RecoveryDecision",
      "type": "object"
    },
    "RecoveryObservation": {
      "additionalProperties": false,
      "description": "Append-only observation — never overwrite prior rows.",
      "properties": {
        "bindingJson": {
          "additionalProperties": true,
          "title": "Bindingjson",
          "type": "object"
        },
        "caseId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Caseid",
          "type": "string"
        },
        "evidenceHash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidencehash",
          "type": "string"
        },
        "evidenceRef": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidenceref"
        },
        "observationId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Observationid",
          "type": "string"
        },
        "observedAt": {
          "format": "date-time",
          "title": "Observedat",
          "type": "string"
        },
        "resultCode": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Resultcode",
          "type": "string"
        },
        "subjectRef": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Subjectref",
          "type": "string"
        },
        "subjectType": {
          "enum": [
            "native_session",
            "workspace",
            "instance_operation",
            "delivery",
            "candidate",
            "authorization",
            "budget",
            "driver_projection"
          ],
          "title": "Subjecttype",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "support": {
          "enum": [
            "supported",
            "unsupported",
            "partial",
            "unknown"
          ],
          "title": "Support",
          "type": "string"
        }
      },
      "required": [
        "observationId",
        "caseId",
        "subjectType",
        "subjectRef",
        "observedAt",
        "support",
        "resultCode",
        "evidenceHash"
      ],
      "title": "RecoveryObservation",
      "type": "object"
    },
    "RecoveryRecommendation": {
      "additionalProperties": false,
      "description": "Pure policy output — does not mutate Run or call adapters.",
      "properties": {
        "action": {
          "enum": [
            "observe_existing",
            "continue_stage_processing",
            "resume_existing",
            "handoff_new_session",
            "await_reconciliation",
            "block_or_rework",
            "wait_authorization",
            "await_stop_verification",
            "rebuild_projection"
          ],
          "title": "Action",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "reasonCodes": {
          "items": {
            "anyOf": [
              {
                "enum": [
                  "native_state_unknown",
                  "workspace_mismatch",
                  "pending_side_effects",
                  "pending_stop_verification",
                  "recovery_evidence_stale",
                  "resume_unsupported",
                  "handoff_confirmation_required",
                  "authorization_invalid",
                  "candidate_hash_mismatch",
                  "budget_unknown",
                  "context_changed",
                  "login_expired"
                ],
                "type": "string"
              },
              {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              }
            ]
          },
          "maxItems": 16,
          "title": "Reasoncodes",
          "type": "array"
        },
        "requiredEvidence": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Requiredevidence",
          "type": "array"
        },
        "requiresUserDecision": {
          "title": "Requiresuserdecision",
          "type": "boolean"
        }
      },
      "required": [
        "action",
        "requiresUserDecision"
      ],
      "title": "RecoveryRecommendation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "appliedDecision": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecoveryDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "case": {
      "$ref": "#/$defs/RecoveryCase"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/RecoveryObservation"
      },
      "maxItems": 64,
      "title": "Observations",
      "type": "array"
    },
    "recommendation": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecoveryRecommendation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "case"
  ],
  "title": "RecoveryReport",
  "type": "object"
}
