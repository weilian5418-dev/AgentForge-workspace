{
  "additionalProperties": false,
  "description": "Immutable StageController decision; not writable by review agents or clients.",
  "properties": {
    "allowedConsumeWorkPackageIds": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._:-]+$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Allowedconsumeworkpackageids",
      "type": "array"
    },
    "candidateId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidateid"
    },
    "candidateSetId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidatesetid"
    },
    "contractHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Contracthash",
      "type": "string"
    },
    "decidedAt": {
      "format": "date-time",
      "title": "Decidedat",
      "type": "string"
    },
    "decisionId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Decisionid",
      "type": "string"
    },
    "gatePolicyVersion": {
      "minimum": 1,
      "title": "Gatepolicyversion",
      "type": "integer"
    },
    "manifestHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifesthash",
      "type": "string"
    },
    "reason": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "result": {
      "enum": [
        "released",
        "rework",
        "blocked"
      ],
      "title": "Result",
      "type": "string"
    },
    "reviewCycleId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewcycleid"
    },
    "reviewRefs": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._:-]+$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Reviewrefs",
      "type": "array"
    },
    "stageId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Stageid",
      "type": "string"
    },
    "userDecisionRef": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Userdecisionref"
    },
    "validationRefs": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._:-]+$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Validationrefs",
      "type": "array"
    }
  },
  "required": [
    "decisionId",
    "stageId",
    "manifestHash",
    "contractHash",
    "gatePolicyVersion",
    "result",
    "reason",
    "decidedAt"
  ],
  "title": "GateDecision",
  "type": "object"
}
