{
  "$defs": {
    "WorkPackageCandidateRef": {
      "additionalProperties": false,
      "description": "One work package → candidate → artifact version binding inside a CandidateSet.",
      "properties": {
        "artifactVersion": {
          "minimum": 1,
          "title": "Artifactversion",
          "type": "integer"
        },
        "candidateId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Candidateid",
          "type": "string"
        },
        "contentHash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contenthash"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "workPackageId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Workpackageid",
          "type": "string"
        }
      },
      "required": [
        "workPackageId",
        "candidateId",
        "artifactVersion"
      ],
      "title": "WorkPackageCandidateRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Concrete release scope — branch release must not mark whole stage released.",
  "properties": {
    "candidateVersions": {
      "items": {
        "$ref": "#/$defs/WorkPackageCandidateRef"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Candidateversions",
      "type": "array"
    },
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    },
    "dependencySatisfiedRefs": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._:-]+$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Dependencysatisfiedrefs",
      "type": "array"
    },
    "gateDecisionId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Gatedecisionid",
      "type": "string"
    },
    "releaseId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Releaseid",
      "type": "string"
    },
    "reviewCycleId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Reviewcycleid",
      "type": "string"
    },
    "scopeKind": {
      "enum": [
        "stage_atomic",
        "dependency_branch"
      ],
      "title": "Scopekind",
      "type": "string"
    },
    "sharedInterfaceStillBlocked": {
      "default": false,
      "title": "Sharedinterfacestillblocked",
      "type": "boolean"
    },
    "stageId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Stageid",
      "type": "string"
    },
    "workPackageIds": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._:-]+$",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Workpackageids",
      "type": "array"
    }
  },
  "required": [
    "releaseId",
    "stageId",
    "reviewCycleId",
    "gateDecisionId",
    "scopeKind",
    "workPackageIds",
    "candidateVersions",
    "createdAt"
  ],
  "title": "ReleaseRecord",
  "type": "object"
}
