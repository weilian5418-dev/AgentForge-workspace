{
  "additionalProperties": false,
  "description": "Pause / resume / cancel / replan intent.\n\nClients cannot declare stopVerified or native paused; those stay platform-owned.",
  "properties": {
    "action": {
      "enum": [
        "pause",
        "resume",
        "cancel",
        "replan"
      ],
      "title": "Action",
      "type": "string"
    },
    "expectedStatusVersion": {
      "minimum": 1,
      "title": "Expectedstatusversion",
      "type": "integer"
    },
    "idempotencyKey": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Idempotencykey",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 1024,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    }
  },
  "required": [
    "action",
    "expectedStatusVersion",
    "idempotencyKey"
  ],
  "title": "RunActionRequest",
  "type": "object"
}
