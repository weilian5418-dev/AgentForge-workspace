{
  "$defs": {
    "BudgetLimits": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "anyOf": [
            {
              "maxLength": 8,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "maxCost": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxcost"
        },
        "maxTokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxtokens"
        },
        "maxWallTimeSeconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxwalltimeseconds"
        }
      },
      "title": "BudgetLimits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "activeGeneration": {
      "minimum": 1,
      "title": "Activegeneration",
      "type": "integer"
    },
    "assignmentVersion": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assignmentversion"
    },
    "budget": {
      "$ref": "#/$defs/BudgetLimits"
    },
    "cancelRequestedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cancelrequestedat"
    },
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    },
    "executionProfile": {
      "enum": [
        "container",
        "host_authorized"
      ],
      "title": "Executionprofile",
      "type": "string"
    },
    "failurePolicy": {
      "enum": [
        "dependency-aware",
        "layer-atomic"
      ],
      "title": "Failurepolicy",
      "type": "string"
    },
    "gatePolicyVersion": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gatepolicyversion"
    },
    "goal": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Goal",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Id",
      "type": "string"
    },
    "inputRefs": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._:-]+$",
        "type": "string"
      },
      "title": "Inputrefs",
      "type": "array"
    },
    "latestSequence": {
      "minimum": 0,
      "title": "Latestsequence",
      "type": "integer"
    },
    "mode": {
      "enum": [
        "auto",
        "single",
        "team"
      ],
      "title": "Mode",
      "type": "string"
    },
    "outputs": {
      "items": {
        "enum": [
          "code",
          "markdown",
          "pptx"
        ],
        "type": "string"
      },
      "title": "Outputs",
      "type": "array"
    },
    "planVersion": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Planversion"
    },
    "planningProviderProfileId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Planningproviderprofileid",
      "type": "string"
    },
    "projectId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Projectid",
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "preflight",
        "routing",
        "planning",
        "awaiting_approval",
        "awaiting_confirmation",
        "preparing",
        "running",
        "awaiting_acceptance",
        "completed",
        "pause_requested",
        "paused",
        "blocked",
        "cancel_requested",
        "canceled",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "statusVersion": {
      "minimum": 1,
      "title": "Statusversion",
      "type": "integer"
    },
    "updatedAt": {
      "format": "date-time",
      "title": "Updatedat",
      "type": "string"
    }
  },
  "required": [
    "id",
    "projectId",
    "goal",
    "mode",
    "status",
    "statusVersion",
    "activeGeneration",
    "latestSequence",
    "executionProfile",
    "failurePolicy",
    "budget",
    "planningProviderProfileId",
    "outputs",
    "createdAt",
    "updatedAt"
  ],
  "title": "RunSnapshotResponse",
  "type": "object"
}
