        "checkId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Checkid",
          "type": "string"
        },
        "profileId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Profileid",
          "type": "string"
        }
      },
      "required": [
        "profileId",
        "checkId",
        "accessLevel"
