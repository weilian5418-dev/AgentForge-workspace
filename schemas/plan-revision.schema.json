{
  "$defs": {
    "ArtifactContract": {
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Id",
          "type": "string"
        },
        "independentReview": {
          "title": "Independentreview",
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "code",
            "markdown",
            "pptx"
          ],
          "title": "Kind",
          "type": "string"
        },
        "relativePath": {
          "title": "Relativepath",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "validators": {
          "items": {
            "$ref": "#/$defs/ValidatorSpec"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Validators",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "relativePath",
        "required",
        "criteria",
        "validators",
        "independentReview"
      ],
      "title": "ArtifactContract",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Artifactid",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "artifactId",
        "version",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CompilationDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "entityId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entityid"
        },
        "entityType": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entitytype"
        },
        "fieldPath": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fieldpath"
        },
        "message": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "suggestedResolution": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestedresolution"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "CompilationDiagnostic",
      "type": "object"
    },
    "CompilationReport": {
      "additionalProperties": false,
      "description": "Compiler output — not a RunStatus.",
      "properties": {
        "capabilityEvidenceRefs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Capabilityevidencerefs",
          "type": "array"
        },
        "compilerVersion": {
          "default": "plan-compiler-v1",
          "maxLength": 512,
          "minLength": 1,
          "title": "Compilerversion",
          "type": "string"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/CompilationDiagnostic"
          },
          "maxItems": 256,
          "title": "Issues",
          "type": "array"
        },
        "status": {
          "enum": [
            "valid",
            "needs_input",
            "blocked",
            "invalid"
          ],
          "title": "Status",
          "type": "string"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/CompilationDiagnostic"
          },
          "maxItems": 256,
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "CompilationReport",
      "type": "object"
    },
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Id",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "description",
        "required"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "IntegrationPolicySpec": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "executionMode": {
          "default": "container",
          "enum": [
            "container",
            "host_authorized"
          ],
          "title": "Executionmode",
          "type": "string"
        },
        "policyRef": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Policyref",
          "type": "string"
        },
        "requiredReviewRoles": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Requiredreviewroles",
          "type": "array"
        }
      },
      "required": [
        "policyRef",
        "checks"
      ],
      "title": "IntegrationPolicySpec",
      "type": "object"
    },
    "PlanResourceEstimate": {
      "additionalProperties": false,
      "description": "Estimate only — does not reserve execution budget.",
      "properties": {
        "basis": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "maxLength": 8,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "estimatedCost": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimatedcost"
        },
        "maxTokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxtokens"
        },
        "maxWallTimeSeconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maxwalltimeseconds"
        },
        "uncertainties": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Uncertainties",
          "type": "array"
        }
      },
      "required": [
        "basis"
      ],
      "title": "PlanResourceEstimate",
      "type": "object"
    },
    "PlanSpec": {
      "additionalProperties": false,
      "properties": {
        "baselineId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Baselineid",
          "type": "string"
        },
        "constraints": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Constraints",
          "type": "array"
        },
        "gatePolicyVersion": {
          "minimum": 1,
          "title": "Gatepolicyversion",
          "type": "integer"
        },
        "goal": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "hashAlgoVersion": {
          "default": "plan-hash-v1",
          "maxLength": 512,
          "minLength": 1,
          "title": "Hashalgoversion",
          "type": "string"
        },
        "inputIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Inputids",
          "type": "array"
        },
        "integrationPolicy": {
          "anyOf": [
            {
              "$ref": "#/$defs/IntegrationPolicySpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resourceEstimate": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanResourceEstimate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/RoleSpec"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Roles",
          "type": "array"
        },
        "routing": {
          "$ref": "#/$defs/RoutingDecision"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/PlanStageDefinition"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Stages",
          "type": "array"
        },
        "workPackages": {
          "items": {
            "$ref": "#/$defs/PlanWorkPackageSpec"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Workpackages",
          "type": "array"
        }
      },
      "required": [
        "goal",
        "baselineId",
        "routing",
        "roles",
        "workPackages",
        "stages",
        "gatePolicyVersion"
      ],
      "title": "PlanSpec",
      "type": "object"
    },
    "PlanStageDefinition": {
      "additionalProperties": false,
      "description": "Stage definition inside a plan — distinct from execution Stage instances (D09+).",
      "properties": {
        "dependencies": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Dependencies",
          "type": "array"
        },
        "gatePolicy": {
          "$ref": "#/$defs/StageGatePolicy"
        },
        "requiredWorkPackages": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Requiredworkpackages",
          "type": "array"
        },
        "stageId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Stageid",
          "type": "string"
        }
      },
      "required": [
        "stageId",
        "gatePolicy"
      ],
      "title": "PlanStageDefinition",
      "type": "object"
    },
    "PlanWorkPackageSpec": {
      "additionalProperties": false,
      "description": "Plan-time work package definition (no runtime repair/status fields).",
      "properties": {
        "deliverables": {
          "items": {
            "$ref": "#/$defs/ArtifactContract"
          },
          "maxItems": 32,
          "title": "Deliverables",
          "type": "array"
        },
        "dependsOn": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Dependson",
          "type": "array"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "maxItems": 64,
          "title": "Inputs",
          "type": "array"
        },
        "maxRepairRounds": {
          "default": 3,
          "maximum": 10,
          "minimum": 0,
          "title": "Maxrepairrounds",
          "type": "integer"
        },
        "objective": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "ownerRoleId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Ownerroleid",
          "type": "string"
        },
        "readScopes": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Readscopes",
          "type": "array"
        },
        "sharedWriteCoordination": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required when write scopes overlap with another package.",
          "title": "Sharedwritecoordination"
        },
        "stageId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Stageid",
          "type": "string"
        },
        "toolPolicyId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Toolpolicyid",
          "type": "string"
        },
        "writeScopes": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Writescopes",
          "type": "array"
        }
      },
      "required": [
        "id",
        "stageId",
        "objective",
        "ownerRoleId",
        "toolPolicyId"
      ],
      "title": "PlanWorkPackageSpec",
      "type": "object"
    },
    "RoleSpec": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "additionalProperties": true,
          "title": "Budget",
          "type": "object"
        },
        "independentReview": {
          "title": "Independentreview",
          "type": "boolean"
        },
        "readScopes": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Readscopes",
          "type": "array"
        },
        "requireUserDecisionOnGate": {
          "default": false,
          "title": "Requireuserdecisionongate",
          "type": "boolean"
        },
        "requiredCapabilities": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Requiredcapabilities",
          "type": "array"
        },
        "responsibilities": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Responsibilities",
          "type": "string"
        },
        "roleId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Roleid",
          "type": "string"
        },
        "writeScopes": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Writescopes",
          "type": "array"
        }
      },
      "required": [
        "roleId",
        "responsibilities",
        "requiredCapabilities",
        "independentReview"
      ],
      "title": "RoleSpec",
      "type": "object"
    },
    "RoutingDecision": {
      "additionalProperties": false,
      "description": "Suggestion only. Never authorizes execution by itself.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "mode": {
          "enum": [
            "single",
            "team",
            "needs_input",
            "undecided"
          ],
          "title": "Mode",
          "type": "string"
        },
        "modelReviewCount": {
          "maximum": 1,
          "minimum": 0,
          "title": "Modelreviewcount",
          "type": "integer"
        },
        "reason": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "ruleVersion": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Ruleversion",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        }
      },
      "required": [
        "mode",
        "reason",
        "ruleVersion",
        "modelReviewCount"
      ],
      "title": "RoutingDecision",
      "type": "object"
    },
    "StageGatePolicy": {
      "additionalProperties": false,
      "properties": {
        "conflictResolution": {
          "default": "escalate_user",
          "enum": [
            "escalate_user",
            "unanimous",
            "majority"
          ],
          "title": "Conflictresolution",
          "type": "string"
        },
        "maxRepairRounds": {
          "default": 3,
          "maximum": 10,
          "minimum": 0,
          "title": "Maxrepairrounds",
          "type": "integer"
        },
        "policy": {
          "default": "stage_atomic",
          "enum": [
            "stage_atomic",
            "dependency_branch"
          ],
          "title": "Policy",
          "type": "string"
        },
        "requireUserDecision": {
          "default": false,
          "title": "Requireuserdecision",
          "type": "boolean"
        },
        "requiredReviewRoles": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Requiredreviewroles",
          "type": "array"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "title": "StageGatePolicy",
      "type": "object"
    },
    "ValidatorSpec": {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "criterionIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Criterionids",
          "type": "array"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Id",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "criterionIds",
        "required"
      ],
      "title": "ValidatorSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable stored plan revision (full replacement).",
  "properties": {
    "compilation": {
      "$ref": "#/$defs/CompilationReport"
    },
    "contextId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Contextid",
      "type": "string"
    },
    "contractHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Contracthash",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    },
    "planHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Planhash",
      "type": "string"
    },
    "planVersion": {
      "minimum": 1,
      "title": "Planversion",
      "type": "integer"
    },
    "runId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Runid",
      "type": "string"
    },
    "spec": {
      "$ref": "#/$defs/PlanSpec"
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "rejected",
        "superseded"
      ],
      "title": "Status",
      "type": "string"
    },
    "supersedesVersion": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedesversion"
    }
  },
  "required": [
    "runId",
    "planVersion",
    "planHash",
    "contractHash",
    "status",
    "spec",
    "compilation",
    "contextId",
    "createdAt"
  ],
  "title": "PlanRevision",
  "type": "object"
}
