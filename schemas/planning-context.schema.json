{
  "additionalProperties": false,
  "description": "Versioned authorized facts used for one planning attempt.",
  "properties": {
    "baselineId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Baselineid",
      "type": "string"
    },
    "contentHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Contenthash",
      "type": "string"
    },
    "contextId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Contextid",
      "type": "string"
    },
    "contextManifestId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set only when a real ContextManifest was built for model egress; never fake.",
      "title": "Contextmanifestid"
    },
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    },
    "inputIds": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._:-]+$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Inputids",
      "type": "array"
    },
    "projectId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Projectid",
      "type": "string"
    },
    "readScopes": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Readscopes",
      "type": "array"
    },
    "runId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Runid",
      "type": "string"
    },
    "summary": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "contextId",
    "projectId",
    "runId",
    "baselineId",
    "summary",
    "contentHash",
    "createdAt"
  ],
  "title": "PlanningContext",
  "type": "object"
}
