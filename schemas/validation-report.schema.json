{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Artifactid",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "artifactId",
        "version",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CriterionResult": {
      "additionalProperties": false,
      "properties": {
        "criterionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Criterionid",
          "type": "string"
        },
        "evidenceRefs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Evidencerefs",
          "type": "array"
        },
        "message": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked",
            "not_run"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "criterionId",
        "status",
        "message"
      ],
      "title": "CriterionResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "contractId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Contractid",
      "type": "string"
    },
    "contractVersion": {
      "minimum": 1,
      "title": "Contractversion",
      "type": "integer"
    },
    "criterionResults": {
      "items": {
        "$ref": "#/$defs/CriterionResult"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Criterionresults",
      "type": "array"
    },
    "environmentRef": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Environmentref",
      "type": "string"
    },
    "evidenceRefs": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._:-]+$",
        "type": "string"
      },
      "maxItems": 128,
      "title": "Evidencerefs",
      "type": "array"
    },
    "failureClass": {
      "anyOf": [
        {
          "enum": [
            "content",
            "environment",
            "transient",
            "permission"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failureclass"
    },
    "finishedAt": {
      "format": "date-time",
      "title": "Finishedat",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Id",
      "type": "string"
    },
    "startedAt": {
      "format": "date-time",
      "title": "Startedat",
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "not_run"
      ],
      "title": "Status",
      "type": "string"
    },
    "validatorId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Validatorid",
      "type": "string"
    },
    "validatorVersion": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Validatorversion",
      "type": "string"
    }
  },
  "required": [
    "id",
    "artifact",
    "contractId",
    "contractVersion",
    "validatorId",
    "validatorVersion",
    "status",
    "criterionResults",
    "environmentRef",
    "startedAt",
    "finishedAt"
  ],
  "title": "ValidationReport",
  "type": "object"
}
