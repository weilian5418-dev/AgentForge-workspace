{
  "additionalProperties": false,
  "description": "Confirm or reject a concrete confirmation request binding.",
  "properties": {
    "assignmentVersion": {
      "minimum": 1,
      "title": "Assignmentversion",
      "type": "integer"
    },
    "confirmationRequestId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Confirmationrequestid",
      "type": "string"
    },
    "decision": {
      "enum": [
        "approve",
        "reject"
      ],
      "title": "Decision",
      "type": "string"
    },
    "gatePolicyVersion": {
      "minimum": 1,
      "title": "Gatepolicyversion",
      "type": "integer"
    },
    "note": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "planHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Planhash",
      "type": "string"
    },
    "planVersion": {
      "minimum": 1,
      "title": "Planversion",
      "type": "integer"
    },
    "statusVersion": {
      "minimum": 1,
      "title": "Statusversion",
      "type": "integer"
    }
  },
  "required": [
    "decision",
    "confirmationRequestId",
    "planVersion",
    "planHash",
    "assignmentVersion",
    "gatePolicyVersion",
    "statusVersion"
  ],
  "title": "PlanDecisionRequest",
  "type": "object"
}
