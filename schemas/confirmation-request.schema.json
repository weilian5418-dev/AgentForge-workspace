{
  "additionalProperties": false,
  "description": "Exact confirmation scope awaiting a user decision.",
  "properties": {
    "assignmentVersion": {
      "minimum": 1,
      "title": "Assignmentversion",
      "type": "integer"
    },
    "capabilityCheckRefs": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._:-]+$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Capabilitycheckrefs",
      "type": "array"
    },
    "compilationReportRef": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compilationreportref"
    },
    "createdAt": {
      "format": "date-time",
      "title": "Createdat",
      "type": "string"
    },
    "expiresAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expiresat"
    },
    "failureReason": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failurereason"
    },
    "gatePolicyVersion": {
      "minimum": 1,
      "title": "Gatepolicyversion",
      "type": "integer"
    },
    "planHash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Planhash",
      "type": "string"
    },
    "planVersion": {
      "minimum": 1,
      "title": "Planversion",
      "type": "integer"
    },
    "requestId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Requestid",
      "type": "string"
    },
    "runId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Runid",
      "type": "string"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "superseded",
        "expired"
      ],
      "title": "Status",
      "type": "string"
    },
    "statusVersion": {
      "minimum": 1,
      "title": "Statusversion",
      "type": "integer"
    }
  },
  "required": [
    "requestId",
    "runId",
    "planVersion",
    "planHash",
    "assignmentVersion",
    "gatePolicyVersion",
    "statusVersion",
    "createdAt"
  ],
  "title": "ConfirmationRequest",
  "type": "object"
}
