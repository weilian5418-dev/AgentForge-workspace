# Copy to .env if needed. No credentials are generated from this file.
AGENTFORGE_HOST=127.0.0.1
AGENTFORGE_PORT=8765
AGENTFORGE_STATE_DIR=.agentforge
AGENTFORGE_LOG_LEVEL=INFO
# Optional: existing database, use an authorized role; never the admin account in production.
# URL-encode reserved characters in username/password. No automatic migrations on startup.
# AGENTFORGE_DATABASE_URL=postgresql+psycopg://agentforge_api:YOUR_PASSWORD@127.0.0.1:5432/agentforge
# Queue dispatch/work (driver role with schema queue DML). Required for `agentforge queue *`.
# AGENTFORGE_QUEUE_DATABASE_URL=postgresql+psycopg://agentforge_driver:YOUR_PASSWORD@127.0.0.1:5432/agentforge
# Alembic only: temporarily override with agentforge_migrator; do not keep migrator in app .env.
# Alternative to the local token file: an environment secret of at least 32 characters.
# AGENTFORGE_API_TOKEN=YOUR_RANDOM_SECRET

# Internal callbacks: provide a separate random >=32 character signing key through secure configuration.
# No public API issues this key; do not pass it to Agent products or commit it.
# AGENTFORGE_INTERNAL_SIGNING_KEY=YOUR_SEPARATE_RANDOM_KEY
# `queue work --control` is a trusted driver process. Its DATABASE_URL must use agentforge_driver.
# Ordinary queue-only workers must never receive that URL or the internal signing key.
