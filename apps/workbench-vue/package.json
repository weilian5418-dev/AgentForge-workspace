{
  "name": "workbench-vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "build:reference": "vue-tsc --noEmit -p tsconfig.app.json && vite build --mode reference",
    "test:unit": "vitest run",
    "test:visual": "playwright test e2e/reference.spec.ts",
    "test:workflow": "playwright test e2e/workflow.spec.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@animate-ui/vue": "2.4.6",
    "@tanstack/vue-query": "5.108.1",
    "@vue-flow/background": "1.3.2",
    "@vue-flow/core": "1.48.2",
    "@vueuse/core": "15.0.0",
    "dompurify": "3.4.18",
    "eventsource-parser": "4.1.3",
    "lucide-vue-next": "0.511.0",
    "markdown-it": "15.0.3",
    "monaco-editor": "0.57.0",
    "motion-v": "2.13.0",
    "pinia": "4.1.0",
    "reka-ui": "2.11.0",
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/dompurify": "3.2.0",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "@vue/tsconfig": "^0.8.1",
    "msw": "2.12.1",
    "openapi-typescript": "7.13.0",
    "pixelmatch": "7.1.0",
    "sharp": "0.34.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  }
}
